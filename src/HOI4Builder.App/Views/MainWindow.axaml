<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HOI4Builder.App.ViewModels"
        x:Class="HOI4Builder.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1280" Height="800"
        Icon="/Assets/avalonia-logo.ico"
        Title="HOI4Builder">

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}" />
        <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+Z" Command="{Binding RedoCommand}" />
    </Window.KeyBindings>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New mod..." Click="OnNewMod" />
                <MenuItem Header="_Import mod folder..." IsEnabled="False" />
                <MenuItem Header="_Open project..." Click="OnOpenProject" />
                <Separator />
                <MenuItem Header="_Save" Click="OnSave" InputGesture="Ctrl+S" IsEnabled="{Binding HasProject}" />
                <MenuItem Header="Save _as..." Click="OnSaveAs" InputGesture="Ctrl+Shift+S" IsEnabled="{Binding HasProject}" />
                <MenuItem Header="_Export mod" IsEnabled="False" />
                <Separator />
                <MenuItem Header="_Close project"
                          Click="OnCloseProject"
                          IsEnabled="{Binding HasProject}" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo" Command="{Binding UndoCommand}" InputGesture="Ctrl+Z" />
                <MenuItem Header="_Redo" Command="{Binding RedoCommand}" InputGesture="Ctrl+Y" />
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="_Validate" IsEnabled="False" />
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Bottom" Padding="10,4">
            <TextBlock Text="{Binding StatusText}" />
        </Border>

        <DockPanel DockPanel.Dock="Left" Width="220" IsEnabled="{Binding HasProject}">
        <StackPanel DockPanel.Dock="Top" Margin="8" Spacing="6">
            <TextBlock Text="Country" />
            <ComboBox ItemsSource="{Binding Selection.All}"
                    SelectedItem="{Binding Selection.Selected}"
                    HorizontalAlignment="Stretch" />
            <TextBox Text="{Binding Selection.NewTag}" PlaceholderText="Tag (e.g. GER)" />
            <TextBox Text="{Binding Selection.NewName}" PlaceholderText="Name (optional)" />
            <Button Content="Add country"
                    Command="{Binding Selection.AddCountryCommand}"
                    HorizontalAlignment="Stretch" />
            <TextBlock Text="{Binding Selection.AddError}"
                    IsVisible="{Binding Selection.HasAddError}"
                    Foreground="#e5534b"
                    TextWrapping="Wrap" />
        </StackPanel>
        <ListBox ItemsSource="{Binding Editors}"
                SelectedItem="{Binding SelectedEditor}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:EditorEntry">
                    <TextBlock Text="{Binding Title}" Margin="6,4" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        </DockPanel>

        <Grid>
            <ContentControl Content="{Binding SelectedEditor.ViewModel}"
                            IsVisible="{Binding HasProject}" />

            <StackPanel IsVisible="{Binding ShowStartScreen}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="10"
                        Width="280">
                <TextBlock Text="IronBuilder" FontSize="30" HorizontalAlignment="Center" />
                <TextBlock Text="Start a new mod or continue an existing one."
                           Opacity="0.7"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,12" />
                <Button Content="Create a Mod" Click="OnNewMod" HorizontalAlignment="Stretch" />
                <Button Content="Import existing mod folder" Click="OnImportMod" HorizontalAlignment="Stretch" />
                <Button Content="Open project" IsEnabled="False" HorizontalAlignment="Stretch" />
                <Button Content="Load sample project"
                        Command="{Binding LoadSampleProjectCommand}"
                        HorizontalAlignment="Stretch" />
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>