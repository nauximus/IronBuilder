<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HOI4Builder.App.ViewModels"
        xmlns:views="using:HOI4Builder.App.Views"
        x:Class="HOI4Builder.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1280" Height="800"
        Icon="/Assets/avalonia-logo.ico"
        Title="HOI4Builder">

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}" />
        <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+Z" Command="{Binding RedoCommand}" />
    </Window.KeyBindings>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New mod..." Click="OnNewMod" />
                <MenuItem Header="_Import mod folder..." IsEnabled="False" />
                <MenuItem Header="_Open project..." Click="OnOpenProject" />
                <Separator />
                <MenuItem Header="_Save" Click="OnSave" InputGesture="Ctrl+S" IsEnabled="{Binding HasProject}" />
                <MenuItem Header="Save _as..." Click="OnSaveAs" InputGesture="Ctrl+Shift+S" IsEnabled="{Binding HasProject}" />
                <MenuItem Header="_Export mod" Click="OnExportMod" IsEnabled="{Binding HasProject}" />
                <MenuItem Header="Export mod _to..." Click="OnExportModTo" IsEnabled="{Binding HasProject}" />
                <Separator />
                <MenuItem Header="_Close project"
                          Click="OnCloseProject"
                          IsEnabled="{Binding HasProject}" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo" Command="{Binding UndoCommand}" InputGesture="Ctrl+Z" />
                <MenuItem Header="_Redo" Command="{Binding RedoCommand}" InputGesture="Ctrl+Y" />
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="_Validate" IsEnabled="False" />
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Bottom" Padding="10,4">
        <TextBlock Text="{Binding StatusText}" />
        </Border>

        <views:SidebarView DockPanel.Dock="Left" Width="220" />

        <Grid>
            <ContentControl Content="{Binding SelectedPage.ViewModel}"
                            IsVisible="{Binding !ShowStartScreen}"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch" />

            <StackPanel IsVisible="{Binding ShowStartScreen}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="10"
                        Width="280">
                <TextBlock Text="IronBuilder" FontSize="30" HorizontalAlignment="Center" />
                <TextBlock Text="Start a new mod or continue an existing one."
                           Opacity="0.7"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,12" />
                <Button Content="Create a Mod" Click="OnNewMod" HorizontalAlignment="Stretch" />
                <Button Content="Import existing mod folder" Click="OnImportMod" HorizontalAlignment="Stretch" />
                <Button Content="Open project" IsEnabled="False" HorizontalAlignment="Stretch" />
                <Button Content="Load sample project"
                        Command="{Binding LoadSampleProjectCommand}"
                        HorizontalAlignment="Stretch" />
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>