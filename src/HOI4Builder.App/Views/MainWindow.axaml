<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HOI4Builder.App.ViewModels"
        x:Class="HOI4Builder.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1280" Height="800"
        Icon="/Assets/avalonia-logo.ico"
        Title="HOI4Builder">

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}" />
        <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+Z" Command="{Binding RedoCommand}" />
    </Window.KeyBindings>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New" IsEnabled="False" />
                <MenuItem Header="_Open..." IsEnabled="False" />
                <MenuItem Header="_Save" IsEnabled="False" />
                <MenuItem Header="Save _as..." IsEnabled="False" />
                <Separator />
                <MenuItem Header="_Export mod" IsEnabled="False" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo" Command="{Binding UndoCommand}" InputGesture="Ctrl+Z" />
                <MenuItem Header="_Redo" Command="{Binding RedoCommand}" InputGesture="Ctrl+Y" />
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="_Validate" IsEnabled="False" />
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Bottom" Padding="10,4">
            <TextBlock Text="{Binding StatusText}" />
        </Border>

        <ListBox DockPanel.Dock="Left"
                 Width="200"
                 ItemsSource="{Binding Editors}"
                 SelectedItem="{Binding SelectedEditor}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:EditorEntry">
                    <TextBlock Text="{Binding Title}" Margin="6,4" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <ContentControl Content="{Binding SelectedEditor.ViewModel}" />
    </DockPanel>
</Window>